# Przykładowa konfiguracja — NIE wpisuj prawdziwego tokenu do GitHub!
DISCORD_TOKEN=NOWY_TOKEN_TUTAJ
CLIENT_ID=APPLICATION_ID_TUTAJ
GUILD_ID=ID_SERWERA_TUTAJ
YTDLP_AUTO_INSTALL=1
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
IDLE_MINUTES=10
# YOUTUBE_PLAYER_CLIENT=web_safari,web_embedded
# YOUTUBE_FETCH_METADATA=1
# YOUTUBE_FORMAT=bestaudio/best
# YOUTUBE_FORCE_IPV4=0  # Ustaw 1 tylko do jednego testu, jeśli IPv6 hostingu zawodzi
# AUDIUS_ENABLED=1
# JAMENDO_CLIENT_ID=
# BOBER_YOUTUBE_FALLBACK=0

# Opcjonalnie YouTube OAuth (TYLKO dane konta i playlist, NIE audio):
# YOUTUBE_OAUTH_CLIENT_ID=TWÓJ_ID.apps.googleusercontent.com
# YOUTUBE_OAUTH_CLIENT_SECRET=TWÓJ_GOOGLE_CLIENT_SECRET
# YOUTUBE_OAUTH_REFRESH_TOKEN=TWÓJ_PRYWATNY_REFRESH_TOKEN
# Opcjonalnie Spotify Web API — metadane, NIE audio:
# SPOTIFY_CLIENT_ID=32_ZNAKI_HEX
# SPOTIFY_CLIENT_SECRET=TWÓJ_PRYWATNY_SPOTIFY_CLIENT_SECRET
